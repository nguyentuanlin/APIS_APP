# This `.xcode.env` file is versioned and is used to source the environment
# used when running script phases inside Xcode.
# To customize your local environment, you can create an `.xcode.env.local`
# file that is not versioned.

# NODE_BINARY variable contains the PATH to the node executable.
#
# Customize the NODE_BINARY variable here.
# For example, to use nvm with brew, add the following line
# . "$(brew --prefix nvm)/nvm.sh" --no-use

# Xcode build phases often run with a minimal PATH (especially on CI/EAS).
# Ensure common Node install locations are searchable before resolving.
export PATH="$PATH:/usr/local/bin:/opt/homebrew/bin:/usr/bin"

# Prefer an already-provided NODE_BINARY (e.g., from CI), otherwise resolve
# from common locations with a best-effort fallback.
if [ -z "${NODE_BINARY:-}" ]; then
	if [ -x "/usr/local/bin/node" ]; then
		export NODE_BINARY="/usr/local/bin/node"
	elif [ -x "/opt/homebrew/bin/node" ]; then
		export NODE_BINARY="/opt/homebrew/bin/node"
	elif [ -x "/usr/bin/node" ]; then
		export NODE_BINARY="/usr/bin/node"
	else
		export NODE_BINARY="$(command -v node)"
	fi
fi
